@page
@model TenMinBreakoutModel
@{
    ViewData["Title"] = "10-Minute Breakout Scanner";
}

<div class="page-wrap">
    <div class="nav-row">
        <a class="nav-btn" asp-page="/Index">← Back</a>
    </div>

    <form method="post" asp-page-handler="Refresh" class="header-row">
        <p class="form-title">10-Minute Breakout Scanner</p>
        <label class="settings-label" for="MinChangePct">Minimum Change %</label>
        <input class="min-change-input" asp-for="MinChangePct" type="number" step="0.01" min="0" />
        <button type="submit" class="nav-btn">🔄 Refresh</button>
    </form>

    <p class="section-label">Breakouts</p>
    @if (Model.Rows.Count == 0)
    {
        <p class="empty-msg">No watchlist stocks currently meet the 10-minute breakout filters.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Price</th>
                        <th>Breakout Time</th>
                        <th>Dist</th>
                        <th>Chg%</th>
                        <th>Vol (M)</th>
                        <th>10m High</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Symbol</td>
                        <td>@r.CurrentPrice.ToString("0.00")</td>
                        <td>@r.BreakoutTime</td>
                        <td>@r.PriceDistance.ToString("0.00")</td>
                        <td>@r.ChangePct.ToString("0.00")</td>
                        <td>@(r.Volume?.ToString("0.00") ?? "")</td>
                        <td>@r.First10MinuteHigh.ToString("0.00")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="watchlist-panel">
        <p class="section-label">Watchlist</p>
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p class="hint">@Model.Message</p>
        }
        <form method="post" asp-page-handler="Add" class="add-row">
            <input type="hidden" asp-for="MinChangePct" />
            <input name="NewSymbol" value="@Model.NewSymbol" placeholder="Ticker" maxlength="12" />
            <button type="submit" class="nav-btn">Add</button>
        </form>
        <div class="watch-list">
            @foreach (var s in Model.Watchlist)
            {
                <div class="watch-item">
                    <form method="post" asp-page-handler="Toggle" class="inline-form">
                        <input type="hidden" asp-for="MinChangePct" />
                        <input type="hidden" name="symbol" value="@s.Symbol" />
                        <input type="hidden" name="included" value="@((!s.Included).ToString().ToLowerInvariant())" />
                        <label>
                            <input type="checkbox" @(s.Included ? "checked" : "")
                                   onchange="this.form.submit()" />
                            @s.Symbol
                        </label>
                    </form>
                    <form method="post" asp-page-handler="Remove" class="inline-form">
                        <input type="hidden" asp-for="MinChangePct" />
                        <input type="hidden" name="symbol" value="@s.Symbol" />
                        <button type="submit" class="remove-btn" title="Remove">✕</button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>
